{
  "call_02": { "text": "喂？……喂。还有人吗。" },
  "call_03": { "text": "老周。跑最后一班渡轮的。" },
  "call_04": { "text": "雾太大了。船头都看不见。" },
  "call_05": { "text": "你把航道灯……能给我亮一下吗。" },
  "beacon_03": { "text": "看见了。看见了！" },
  "beacon_04": { "text": "谢谢。这班，我靠岸了。" },
  "music_01": { "text": "不是这首。" },
  "music_02": { "text": "她不爱这首。换一个吧。" },
  "news_01": { "text": "新闻就别念了。" },
  "news_02": { "text": "海里的事，广播里说不清。" },

  "n1_01": { "text": "喂？喂——有人吗？" },
  "n1_02": { "text": "罗盘坏了。全是雾，我什么都看不见。" },
  "n1_03": { "text": "我这儿……北纬三十四度十二分，东经一百二十九度零七分。" },
  "n1_04": { "text": "船上还有人。你给我个方向就行。" },
  "n1_05": { "text": "对，就那儿。三号浮标，我看见了。" },
  "n1_06": { "text": "七号渔协的，船号零三。" },
  "n1_07": { "text": "有了。灯扫过来了。" },
  "n1_08": { "text": "防波堤看见了。谢了，守夜的。" },

  "n2_04": { "text": "小满，妈这盘带子……录了七遍。" },
  "n2_05": { "text": "那年冬天你走的时候，我说的是，别再回来了。" },
  "n2_06": { "text": "我不该那么说。" },
  "n2_08": { "text": "就这句。谢谢你，守夜的。" },
  "n2_10": { "text": "别提他父亲。" },
  "n2_11": { "text": "别说关灯。他怕黑。" },
  "n2_13": { "text": "你走了以后，我学着不再问你去了哪。" },
  "n2_14": { "text": "灯……我一直给你留着。" },

  "n3_01": { "text": "……有人吗。" },
  "n3_02": { "text": "我在下面。防空洞。" },
  "n3_03": { "text": "电键卡住了。你听好。" },
  "n3_04": { "text": "呼号，三组。" },
  "n3_05": { "text": "收到没有？" },
  "n3_06": { "text": "你还记得那艘船。" },
  "n3_07": { "text": "潮生号。四八年沉的。" },
  "n3_08": { "text": "我等了七十年，才等到有人回话。" },
  "n3_09": { "text": "谢谢你，守夜的。" }
}
