{
  "call_02": { "text": "……喂？还有人守着吗。" },
  "call_03": { "text": "我是老周。最后一班渡轮的船长。" },
  "call_04": { "text": "雾太厚了。我什么都看不见。" },
  "call_05": { "text": "能不能……把航道灯给我点亮。" },
  "beacon_03": { "text": "……看见了。我看见了。" },
  "beacon_04": { "text": "谢谢你。这一班，我靠岸了。" },
  "music_01": { "text": "不是这首。" },
  "music_02": { "text": "……她不爱这首。" },
  "news_01": { "text": "今晚不听新闻了。" },
  "news_02": { "text": "海里的事，新闻说不清。" }
}
